# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — found in Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key — safe to expose in client-side code
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Dropbox ───────────────────────────────────────────────────────────────────
# Create a Dropbox app at https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret
# Long-lived access token (generate via Dropbox OAuth or the app console)
DROPBOX_ACCESS_TOKEN=your-dropbox-access-token

# Dropbox folder paths to sync from (must exist in Dropbox)
DROPBOX_VIDEO_FOLDER=/LIFEFM/Video Shows
DROPBOX_MIXES_FOLDER=/LIFEFM/DJ Mixes
DROPBOX_FLYERS_FOLDER=/LIFEFM/Event Flyers
DROPBOX_PHOTOS_FOLDER=/LIFEFM/Photos
DROPBOX_SCHEDULE_FOLDER=/LIFEFM/Schedule

# Client-side flag — set to "true" once DROPBOX_ACCESS_TOKEN is configured
NEXT_PUBLIC_DROPBOX_CONNECTED=false

# ── Stream ────────────────────────────────────────────────────────────────────
# Restream.io embed player token (visible in client HTML — not a secret)
NEXT_PUBLIC_RESTREAM_TOKEN=your-restream-player-token

# Direct audio stream URL for the visualiser "Stream" source
# Must return a stream with CORS headers (Access-Control-Allow-Origin: *)
# e.g. https://streaming.radio.co/s_XXXXXXXX/listen
NEXT_PUBLIC_STREAM_AUDIO_URL=

# Set to "true" to show the LIVE badge overlay on the stream player
NEXT_PUBLIC_IS_LIVE=false

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical site URL — used for SEO metadata and sitemaps
NEXT_PUBLIC_SITE_URL=https://lifefm.tv

# ── Sponsorship ──────────────────────────────────────────────────────────────
# Metro Bank details shown in the show sponsorship booking wizard
NEXT_PUBLIC_METRO_SORT_CODE=XX-XX-XX
NEXT_PUBLIC_METRO_ACCOUNT_NUMBER=XXXXXXXX

# ── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret to protect the /api/sync/dropbox cron endpoint
# Set the same value in Vercel → Settings → Environment Variables
# Leave blank to allow unauthenticated access (only do this locally)
CRON_SECRET=
